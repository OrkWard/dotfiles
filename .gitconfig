[core]
	ignorecase = false
	excludesFile = ~/.config/git/ignore
[rebase]
	autoStash = true
[pull]
	rebase = true
[commit]
	gpgsign = true
[merge]
	conflictstyle = zdiff3
[diff]
	external = difft --display side-by-side-show-both
	algorithm = histogram
[include]
	path = .gitconfig.local
[alias]
	sw = switch
	b = branch
	wt = worktree
	adog = log --all --decorate --oneline --graph
	dog = log --decorate --oneline --graph
	dl = log --ext-diff
	ds = show --ext-diff
	dd = diff
[init]
	defaultBranch = master
[credential]
	helper = cache
[fetch]
	prune = true
[help]
	autocorrect = 20
[push]
	autoSetupRemote = true
[safe]
	directory = *
